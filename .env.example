PGHOST=localhost
PGPORT=5432
PGDATABASE=your_database_name
PGUSER=postgres
PGPASSWORD=your_postgres_password
SESSION_SECRET=generate_with_node_-e_console.log(require('crypto').randomBytes(48).toString('hex'))
PORT=4000
COOKIE_SECURE=false

# Contact form (server/server/mailer.js) — sends the message to CONTACT_TO_EMAIL,
# with the visitor's address set as Reply-To. Defaults target Gmail:
# 1. Turn on 2-Step Verification on the sending Gmail account.
# 2. Google Account -> Security -> App Passwords -> generate one for "Mail".
# 3. SMTP_USER is that Gmail address, SMTP_PASS is the 16-character app password
#    (paste it with no spaces).
# Using a different SMTP provider instead? Override SMTP_HOST/SMTP_PORT/SMTP_SECURE.
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password
# Optional — defaults to SMTP_USER (the same inbox you're sending from) if unset.
CONTACT_TO_EMAIL=
